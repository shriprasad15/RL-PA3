{
  "section": "2.2_lunarlander",
  "experiment_id": "hover_auto",
  "agent": "SAC",
  "env": "LunarLander-v3 continuous=True + hover box",
  "continuous": true,
  "hover_box": "|x| < 0.1 and 0.4 < |y| < 0.6",
  "hover_reward_before": 200.0,
  "hover_reward_after": -100.0,
  "reward_change_step": 300000,
  "fixed_alpha": null,
  "autotune_alpha": true,
  "seed": 5,
  "total_steps": 600000,
  "steps_pre": 300000,
  "steps_post": 300000,
  "initial_random_steps": 10000,
  "update_after": 10000,
  "replay_buffer_size": 100000,
  "replay_buffer_type": "fixed-size (TA rule for hover reward switch)",
  "batch_size": 256,
  "gamma": 0.99,
  "tau": 0.005,
  "actor_lr": 0.0003,
  "critic_lr": 0.0003,
  "alpha_lr": 0.0003,
  "init_alpha": 0.2,
  "target_entropy": -2,
  "eval_every": 10000,
  "eval_episodes": 20
}