\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Final policy snapshots at $t=999$ for all target angles (auto-$\alpha $). Easy targets ($0^\circ $, $-10^\circ $, $-150^\circ $) show near-zero angle error. Hard targets ($\pm 90^\circ $, $120^\circ $) stabilize at a compromise angle due to torque constraints. Note that all policies achieve $|\dot  \theta |=0$ (successful damping), but only feasible targets achieve low angle error.}}{3}{figure.caption.3}\protected@file@percent }
\newlabel{fig:pendulum_snapshots}{{2}{3}{Final policy snapshots at $t=999$ for all target angles (auto-$\alpha $). Easy targets ($0^\circ $, $-10^\circ $, $-150^\circ $) show near-zero angle error. Hard targets ($\pm 90^\circ $, $120^\circ $) stabilize at a compromise angle due to torque constraints. Note that all policies achieve $|\dot \theta |=0$ (successful damping), but only feasible targets achieve low angle error}{figure.caption.3}{}}
